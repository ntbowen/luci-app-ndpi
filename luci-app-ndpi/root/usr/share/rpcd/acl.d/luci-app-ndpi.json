{
	"luci-app-ndpi": {
		"description": "Grant access to nDPI DPI Firewall configuration",
		"read": {
			"ubus": {
				"ndpi": ["getStatus", "getMemory", "getFlows", "getProtocols",
				         "getAlerts", "getTraffic", "getInterfaceStats"]
			},
			"uci": ["ndpi"],
			"file": {
				"/tmp/ndpi_flows.json": ["read"],
				"/tmp/ndpi_alerts.log": ["read"],
				"/proc/meminfo": ["read"],
				"/proc/net/nf_conntrack": ["read"],
				"/sys/class/net/*/statistics/*": ["read"],
				"/etc/config/ndpi": ["read"]
			}
		},
		"write": {
			"ubus": {
				"ndpi": ["startService", "stopService", "restartService"]
			},
			"uci": ["ndpi"],
			"file": {
				"/etc/config/ndpi": ["write"]
			}
		}
	}
}
