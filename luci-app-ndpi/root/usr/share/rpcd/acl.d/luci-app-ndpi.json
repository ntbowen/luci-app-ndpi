{
	"luci-app-ndpi": {
		"description": "Grant access to nDPI DPI Firewall configuration",
		"read": {
			"ubus": {
				"ndpi": ["getStatus", "getMemory", "getFlows", "getProtocols",
				         "getAlerts", "getTraffic", "getInterfaceStats",
				         "getInterfaces", "getDebug"]
			},
			"uci": ["ndpi"]
		},
		"write": {
			"ubus": {
				"ndpi": ["startService", "stopService", "restartService"]
			},
			"uci": ["ndpi"]
		}
	}
}
