# nDPI Deep Packet Inspection Configuration

config ndpi 'global'
	option enabled '1'
	option interface 'br-lan'
	option log_level '1'
	option json_log '/tmp/ndpi_flows.json'
	option flow_idle_timeout '30'
	option flow_max_packets '10'
	option enable_guess '1'
	option decode_tunnels '1'
	option track_payload '0'

config analysis 'dpi'
	option tls_fingerprint '1'
	option quic_detection '1'
	option dns_analysis '1'
	option http_analysis '1'
	option ssh_fingerprint '1'
	option ja3_fingerprint '1'
	option ja4_fingerprint '1'
	option hassh_fingerprint '1'
	option detect_encrypted '1'
	option stun_whatsapp '1'

# Individual protocol enable/disable (all enabled by default)
# The DPI Settings page manages these options via the CBI model.
# Option names are proto_<lowercase_protocol_name>.
config ndpi_protocols 'protocols'

config flow_collection 'collector'
	option enabled '0'
	option netflow_enabled '0'
	option netflow_port '2055'
	option netflow_version '9'
	option sflow_enabled '0'
	option sflow_port '6343'
	option ipfix_enabled '0'
	option ipfix_port '4739'
	option collector_interface '0.0.0.0'

config historical 'storage'
	option enabled '0'
	option backend 'sqlite'
	option retention_days '30'
	option db_path '/tmp/ndpi_history.db'
	option max_db_size '100'
	option export_format 'json'

config security 'alerts'
	option enabled '1'
	option max_alerts '500'
	option alert_log '/tmp/ndpi_alerts.log'
	option syslog_enabled '1'
	option email_enabled '0'
	option email_recipient ''
	option threshold_bandwidth '0'
	option threshold_connections '1000'
	option detect_port_scan '1'
	option detect_syn_flood '1'
	option detect_dns_tunnel '1'

config traffic_behavior 'behavior'
	option enabled '1'
	option periodic_scan '1'
	option scan_interval '60'
	option anomaly_detection '1'
	option baseline_hours '24'
	option deviation_threshold '3'

config site_hierarchy 'sites'
	option enabled '0'
	option site_name 'Default'
	option group_mode 'subnet'
